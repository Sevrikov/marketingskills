# App
APP_ENV=local
APP_NAME=ai-marketing-content-factory
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Database
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/ai_content_factory

# Queue / Cache
REDIS_URL=redis://redis:6379/0
QUEUE_MODE=rq
SKILL_REGISTRY_ROOT=/workspace-agents/skills
OPERATOR_CONSOLE_URL=http://127.0.0.1:5173
LLM_PROVIDER=mock
RESEARCH_PROVIDER=mock
SOURCE_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
CMS_PROVIDER=mock
CMS_DESTINATION_TYPE=generic_cms
IMAGE_GENERATION_PROVIDER=mock

# Object storage
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-content-factory

# Google AI
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_CONTENT_MODEL=gemini-2.5-flash-lite
GEMINI_CRITIC_MODEL=gemini-2.5-flash-lite
GEMINI_RESEARCH_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image-preview,gemini-2.5-flash-image,gemini-3-pro-image-preview
GEMINI_SMOKE_MODELS=gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite-preview
ENABLE_GEMINI_QUOTA_GOVERNOR=true
GEMINI_QUOTA_LEDGER_PATH=.tmp/gemini_quota_ledger.json
GEMINI_DAILY_MODEL_LIMITS=gemini-2.5-flash-lite=20,gemini-3-flash-preview=20,gemini-3.1-flash-lite-preview=500,gemini-embedding-001=1000,gemini-embedding-2=1000
GEMINI_UNAVAILABLE_COOLDOWN_SECONDS=600

# Source collection
TAVILY_API_KEY=
SOURCE_COLLECTION_ENABLED=true
SOURCE_COLLECTION_REQUIRED=false
SOURCE_COLLECTION_MAX_RESULTS=5
SOURCE_CORPUS_MAX_CHARS=20000
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_RAW_CONTENT=markdown
TAVILY_INCLUDE_ANSWER=basic
TAVILY_COUNTRY=

# Price monitor
PRICE_MONITOR_PROVIDER=mock
PRICE_MONITOR_TIMEOUT_SECONDS=20
PRICE_MONITOR_USER_AGENT=AIContentFactoryPriceMonitor/0.1

# Viber approval bot
VIBER_AUTH_TOKEN=
VIBER_REVIEWER_IDS=
VIBER_SENDER_NAME=AI Content Factory
VIBER_WEBHOOK_PUBLIC_URL=
VIBER_WEBHOOK_EVENT_TYPES=message,conversation_started,subscribed,unsubscribed,failed
VIBER_WEBHOOK_SECRET_REQUIRED=false

# Telegram approval bot (reserved fallback)
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Safety
ENABLE_REAL_PUBLISHING=false
ENABLE_REAL_VIDEO_GENERATION=false
ENABLE_REAL_IMAGE_GENERATION=false
ENABLE_GOOGLE_SMOKE_TESTS=false
MONTHLY_AI_BUDGET_USD=100
